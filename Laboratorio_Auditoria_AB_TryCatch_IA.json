      "parameters": {
        "jsCode": "const validador = $('Validador (Regex e Comparador)').first().json;\nconst respostaIA = $input.first().json.text || validador.laudo_sem_ia || 'Análise semântica desnecessária.';\n\nreturn {\n    json: {\n        \"Data\": validador.data,\n        \"Tipo de Teste\": validador.tipo_teste,\n        \"Cliente\": validador.cliente,\n        \"URL\": validador.url,\n        \"Status Antes\": validador.status_antes,\n        \"Status Depois\": validador.status_depois,\n        \"Total Buscadas\": validador.total_buscadas,\n        \"Total Encontradas\": validador.total_encontradas,\n        \"Palavras no Texto\": validador.palavras_encontradas,\n        \"Resultado do Ajuste\": validador.metricas,\n        \"Laudo Técnico\": respostaIA.trim()\n    }\n};"
