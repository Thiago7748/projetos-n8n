    {
      "parameters": {
        "jsCode": "const body = $('Webhook (Postman)').first().json.body || {};\n\nfunction garantirArray(input) {\n    if (!input) return [];\n    if (Array.isArray(input)) return input;\n    return [String(input)];\n}\n\nconst palavrasAntes = garantirArray(body.palavras_chave);\nconst palavrasNovas = garantirArray(body.novas_palavras);\nconst cliente = body.cliente || 'Sem Nome';\nconst url = body.url_da_noticia || 'Sem URL';\n\nconst htmlBruto = $input.first().json.data || '';\n\nconst textoLimpo = htmlBruto\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\nconst normalize = (str) => str.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst textoSiteNorm = normalize(textoLimpo);\n\nfunction validarLista(lista) {\n    let encontradas = [];\n    let faltantes = [];\n    for (let palavra of lista) {\n        if (!palavra || typeof palavra !== 'string') continue;\n        const palavraLimpa = normalize(palavra);\n        const regex = new RegExp(`\\\\b${palavraLimpa}\\\\b`, 'i');\n        if (regex.test(textoSiteNorm)) {\n            encontradas.push(palavra);\n        } else {\n            faltantes.push(palavra);\n        }\n    }\n    let statusMsg = '';\n    if (lista.length === 0) statusMsg = 'Vazio';\n    else if (faltantes.length === 0) statusMsg = 'Match Completo';\n    else if (encontradas.length > 0) statusMsg = 'Match Parcial';\n    else statusMsg = 'Sem Match';\n\n    return { encontradas, faltantes, statusMsg, total: lista.length };\n}\n\n// 1. Diagnóstico da Lista Antiga\nconst resAntes = validarLista(palavrasAntes);\n\n// 2. Diagnóstico da Lista COMPLETA Atualizada (Antes + Novas sem duplicatas)\nconst listaCompletaDepois = Array.from(new Set([...palavrasAntes, ...palavrasNovas]));\nconst resDepois = validarLista(listaCompletaDepois);\n\nlet faltantesAlvo = resAntes.faltantes;\nlet encontradasAlvo = resAntes.encontradas;\nlet totalBuscadas = resAntes.total;\nlet tipoTeste = \"🔍 1º Diagnóstico\";\nlet precisaIA = false;\nlet metricas = \"\";\nlet laudoSemIA = \"\";\n\nif (palavrasNovas.length > 0 && resDepois.statusMsg !== 'Vazio') {\n    tipoTeste = \"⚡ 2º Teste (Ajuste A/B)\";\n    faltantesAlvo = resDepois.faltantes;\n    encontradasAlvo = resDepois.encontradas;\n    totalBuscadas = resDepois.total;\n\n    let pctAntes = resAntes.total > 0 ? (resAntes.encontradas.length / resAntes.total) * 100 : 0;\n    let pctDepois = resDepois.total > 0 ? (resDepois.encontradas.length / resDepois.total) * 100 : 0;\n    let diff = Math.round(pctDepois - pctAntes);\n\n    if (diff > 0) metricas = `🟢 Ajuste Validado (+${diff}%)`;\n    else if (diff < 0) metricas = `🔴 Ajuste Piorou (${diff}%)`;\n    else metricas = `⚪ Ajuste Neutro`;\n\n    // Pula a IA se o novo termo foi suficiente para encontrar a matéria\n    precisaIA = (resDepois.encontradas.length === 0);\n    laudoSemIA = `Análise semântica desnecessária: Ajuste validado (${resDepois.encontradas.length}/${resDepois.total} palavras do conjunto encontradas).`;\n} else {\n    precisaIA = (resAntes.encontradas.length === 0);\n    \n    if (resAntes.statusMsg === 'Sem Match') {\n        metricas = \"🔴 Necessita de Ajuste de Palavras\";\n    } else {\n        metricas = \"⚠️ Palavras OK (Verificar Sistema)\";\n    }\n    laudoSemIA = `Análise semântica desnecessária: Palavras da busca encontradas no texto (${resAntes.encontradas.length}/${resAntes.total}).`;\n}\n\nconst dataAtual = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nreturn {\n    json: {\n        data: dataAtual,\n        tipo_teste: tipoTeste,\n        cliente: cliente,\n        url: url,\n        status_antes: `${resAntes.statusMsg} (${resAntes.encontradas.length}/${resAntes.total})`,\n        status_depois: palavrasNovas.length > 0 ? `${resDepois.statusMsg} (${resDepois.encontradas.length}/${resDepois.total})` : \"Não testado\",\n        metricas: metricas,\n        total_buscadas: totalBuscadas,\n        total_encontradas: encontradasAlvo.length,\n        palavras_encontradas: encontradasAlvo,\n        precisa_ia: precisaIA,\n        laudo_sem_ia: laudoSemIA,\n        palavras_faltantes: faltantesAlvo,\n        texto_bruto_site: textoLimpo.substring(0, 20000)\n    }\n};"
      },
