      "id": "7b2eccac-3c5d-48f7-9a5f-5d3fcee59d08",
      "name": "Marcar como Processando",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -96,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Limpeza do formato e extração de JSON (Anti-Conversa da IA)\nlet raw = String($json.output || '').trim();\n\n// Se a IA colocar papo-furado antes ou depois, extraímos só o JSON pelas chaves {}\nconst jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\nif (jsonMatch) {\n  raw = jsonMatch[0];\n}\n\nlet d;\ntry { \n  d = JSON.parse(raw); \n} catch (e) { \n  throw new Error(`Saída não é JSON válido: ${e.message}`); \n}\n\n// 3. Verifica se a IA esqueceu de gerar algum campo obrigatório\nconst required = ['versao','data','modo','grupo1','grupo2','grupo3','formula','explicacao','fontes'];\nfor (const k of required) {\n  if (d[k] === undefined || d[k] === null) throw new Error(`Campo obrigatório ausente: ${k}`);\n}\n\n// Configuração matemática dos limites de cada grupo\nconst specs = { grupo1:[15,25], grupo2:[10,20], grupo3:[5,12] };\nconst clean = s => String(s).trim().replace(/\\s+/g,' ');\nconst norm = s => clean(s).toLocaleLowerCase('pt-BR').replace(/^\\\"|\\\"$/g,'');\n\n// NOVO: Mata Duplicidades Silencioso (em vez de dar erro, ele apenas remove a duplicata)\nconst seen = new Map();\nfor (const g of Object.keys(specs)) {\n  if (!Array.isArray(d[g])) throw new Error(`${g} não é uma lista.`);\n  \n  const uniqueGroup = [];\n  for (const t of d[g]) {\n    const n = norm(t);\n    // Se a palavra já existe (independente de maiúscula/minúscula), ignora ela!\n    if (!seen.has(n)) {\n      seen.set(n, g);\n      uniqueGroup.push(clean(t));\n    }\n  }\n  d[g] = uniqueGroup.filter(Boolean);\n}\n\nfor (const [g,[min,max]] of Object.entries(specs)) {\n  // 6. O famoso \"Xerife de Limites\"\n  if (d[g].length < min || d[g].length > max) {\n    throw new Error(`${g} possui ${d[g].length} termos; esperado ${min}-${max}.`);\n  }\n  \n  // 7. Impede que a IA coloque \"AND/OR/NOT\" dentro da palavra-chave \n  // (CORRIGIDO: Expressão regular atualizada para ignorar palavras acentuadas que iniciam com \"not\", ex: Notícias)\n  if (d[g].some(t => /(^|\\s)(AND|OR|NOT)(\\s|$)/i.test(t.replace(/^\\\"|\\\"$/g,'')))) {\n    throw new Error(`${g} contém operador booleano dentro de um termo.`);\n  }\n}\n\n// 9. Validações básicas de formato\nif (!['criador','revisor'].includes(String(d.modo).toLowerCase())) throw new Error('Modo inválido.');\nif (!Number.isInteger(Number(d.versao)) || Number(d.versao) < 1) throw new Error('Versão inválida.');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(d.data))) throw new Error('Data inválida.');\n\n// 10. O \"Construtor Perfeito\" da Fórmula Booleana\nconst quote = t => /\\s/.test(t) && !(t.startsWith('\"') && t.endsWith('\"')) ? `\"${t}\"` : t;\n\n// 11. Monta a fórmula bruta matematicamente à prova de falhas com os AND / OR / NOT no lugar exato\nd.formula = `( (${d.grupo1.map(quote).join(' OR ')}) ) AND ( (${d.grupo2.map(quote).join(' OR ')}) ) AND NOT ( ${d.grupo3.map(quote).join(' OR ')} )`;\n\n// Filtra fontes\nd.fontes = Array.isArray(d.fontes) ? d.fontes.filter(f => /^https?:\\/\\//i.test(String(f?.url || ''))).slice(0,20) : [];\n\n// 12. Gera a versão \"Bonita\" (Markdown) para exibição humana\nd.laudo = `# Lógica Booleana\\n**Versão:** ${d.versao} | **Data:** ${d.data} | **Modo:** ${d.modo}\\n\\n## GRUPO 1: ASSUNTO E SINÔNIMOS (OR)\\n${d.grupo1.join(' OR ')}\\n\\n## GRUPO 2: CONTEXTO, MARCA E LOCAL (OR)\\n${d.grupo2.join(' OR ')}\\n\\n## GRUPO 3: EXCLUSÕES PREDITIVAS (NOT)\\n${d.grupo3.join(' OR ')}\\n\\n## FÓRMULA LÓGICA FINAL\\n${d.formula}`;\n\n// 13. Entrega os dados formatados\nreturn { \n  json: { \n    ...$('Ler Solicitações').first().json, \n    resultado: d, \n    resultado_json: JSON.stringify(d), \n    output: raw \n  } \n};"
      },
      "id": "abaa0c63-5141-45c8-8b67-5f81aa1deb74",
      "name": "Validar e Normalizar Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
